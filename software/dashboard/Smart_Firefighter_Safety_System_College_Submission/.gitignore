# Python Caches & Compiled Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Environment & Credentials (NEVER commit credentials)
.env
.env.*
*.pem
*.key

# Logs and Debug Files
*.log
npm-debug.log*
yarn-debug.log*

# Node / JS Dependencies (if any)
node_modules/

# IDE & Operating System Metafiles
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.bak

# Temporary and Scratch Directories
scratch/
.system_generated/
